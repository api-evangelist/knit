{
  "opencollection": "1.0.0",
  "info": {
    "name": "Knit Unified Departments Integrations API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Integrations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Integrations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getknit.dev/v1/integrations"
          },
          "docs": "Returns a list of connected integrations for your account."
        }
      ]
    }
  ],
  "bundled": true
}